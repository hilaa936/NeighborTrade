# Postgres: the app database and a separate one for tests (tests wipe it)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/neighbortrade_dev"
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/neighbortrade_test"

# NextAuth: generate a secret with `openssl rand -base64 32`
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me

# Optional: Google sign-in (the button is hidden when these are empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
